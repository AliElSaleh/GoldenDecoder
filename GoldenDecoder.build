Compiler x86_64-w64-mingw32-gcc
Assembly GoldenDecoder
.Run

Icon Voyager_Golden_Record

BuildDirectory        Build/%Mode
IntermediateDirectory Intermediate/%Mode

if mode == release
{
    SharedCompilerFlags -O3 -funroll-loops -ffast-math
    Linker.Subsystem Windows
}
if mode == debug 
{
    SharedCompilerFlags -O0 -g3
    SharedLinkerFlags -g3
    Compiler.Defines _DEBUG
}

SourceFiles         Source/Program
SourceFiles:windows Resources/GoldenDecoder_WindowIcon

Compiler.Flags          $SharedCompilerFlags -std=gnu99 -fmax-errors=1 -Werror
Linker.Flags            $SharedLinkerFlags
Compiler.Includes       . Libraries
Libraries               RaylibS gdi32 winmm
Library.Paths           Libraries

PostBuild
{
    Copy
    {
        #resources/golden2x-32.wav $(BuildDirectory)/resources
        resources/golden.wav $(BuildDirectory)/resources
        resources/$(Icon).* $(BuildDirectory)/resources
    }
}

Assert.Platform Windows

option.mode(Debug Release)