Compiler:windows msvc
Compiler:unix    gcc

Assembly(preserve_case) GoldenDecoder
.Run

IconFile Voyager_Golden_Record
Icon:!windows $(IconFile)

BuildDirectory        Build/%Mode
IntermediateDirectory Intermediate/%Mode

if mode == release
{
    SharedCompilerFlags:msvc      /O2
    SharedCompilerFlags:gcc|clang -O3
    
    if windows
    {
        Linker.Subsystem       Windows
        Linker.EntryPoint:msvc mainCRTStartup
    }
}

if mode == debug 
{
    SharedCompilerFlags:msvc    /Od
    SharedLinkerFlags:gcc|clang -g3

    Compiler.Defines    _DEBUG
}

SharedCompilerFlags:msvc /MD

SourceFiles         Source/Program
SourceFiles:windows Source/GoldenDecoder_WindowIcon

Compiler.Flags          $SharedCompilerFlags
Linker.Flags            $SharedLinkerFlags
Compiler.Includes       . Libraries
Library.Paths           Libraries
Libraries               Raylib-&Platform-&arch
Libraries:windows       &NativeLibs
Apple.Frameworks        Foundation AppKit IOKit

if windows
{
    Libraries           gdi32 winmm
}

PostBuild.Copy resources/* $(BuildDirectory)/resources

if macos
{
    Apple.Bundle

    BundleApp       $(BuildDirectory)/$(Assembly).app
    BundleContents  $(BundleApp)/Contents
    BundleResources $(BundleContents)/Resources/resources

    PostBuild
    {
        Copy resources/* $(BundleResources)

        Cmd codesign --force --sign - $(BundleApp)
        Cmd ditto -c -k --sequesterRsrc --keepParent $(BundleApp) $(BuildDirectory)/$(Assembly)-&Platform-&(arch).zip
    }
}

Assert.Platform Windows:x64 Linux:x64 Linux:arm64 macOS

option.mode(Debug Release)
